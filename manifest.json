{
  "manifest_version": 3,
  "name": "OGame Mobile Layout",
  "version": "0.16.0",
  "description": "OGame mobile zoom helper for Chromium/Kiwi.",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ogame.gameforge.com/game/*"
      ],
      "css": [
        "layout.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
