{
  "manifest_version": 3,
  "name": "OGame Mobile Layout",
  "version": "0.14.0",
  "description": "OGame mobile zoom helper for Chromium/Kiwi.",
  "content_scripts": [
    {
      "matches": [
        "https://*.ogame.gameforge.com/game/*"
      ],
      "css": [
        "layout.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
